vrrp_script check_haproxy {
    script "/usr/bin/killall -0 haproxy"
    interval 2
    weight 2
}

vrrp_instance VI_1 {
    state {{ keepalived_role }}
    interface eth0
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass HighAvailabilityPass2026
    }

    virtual_ipaddress {
        192.168.1.10/24 dev eth0 label eth0:vip
    }

    track_script {
        check_haproxy
    }
}